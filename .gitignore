# ==========================================
# NewFoobot .gitignore
# ==========================================

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Editors and IDEs
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace
.project
.settings/

# Credentials, Private Keys & Environment overrides
*.key
*.pem
*.pub
*.p12
*.crt
*.csr
.env
.env.local
.env.*.local

# Web Dashboard production overrides
3_web_dashboard_and_database/config.php
3_web_dashboard_and_database/backups/*.sql
3_web_dashboard_and_database/backups/*.sql.gz
!3_web_dashboard_and_database/backups/.htaccess

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
ENV/
env/

# Logs and runtime databases
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/
*.pid

# Temporary and backup files
*.bak
*.bak_*
*.tmp
*.temp
